{
  "name": "spread-probe",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "clean": "rimraf dist",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:api": "node scripts/check-api-refs.mjs",
    "api:table": "node scripts/check-api-refs.mjs --table",
    "smoke": "npm run build && node dev/smoke.cjs && node dev/smoke.cjs grim && node dev/smoke.cjs throw",
    "check": "npm run typecheck && npm run lint && npm run check:api && npm run smoke",
    "package": "bash scripts/package-ccx.sh",
    "verify:ccx": "python3 scripts/verify-ccx.py release/spread-probe.ccx"
  },
  "devDependencies": {
    "@adobe/cc-ext-uxp-types": "^7.3.1",
    "@adobe/eslint-plugin-premierepro": "^26.5.0",
    "@adobe/premierepro": "^26.5.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "description": "Spread — Premiere Pro UXP API yoklama paneli (ADIM 1, yalnızca test)"
}
