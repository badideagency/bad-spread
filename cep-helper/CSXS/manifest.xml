<?xml version="1.0" encoding="UTF-8"?>
<!--
  DİKKAT: XML yorumlarında iki tire art arda YAZILMAZ (XML kuralı; v0.3.0/0.3.1 manifesti bu yüzden geçersiz XML'di).
  `npm run check:xml` bunu ve kimliklerin tutarlılığını denetler.

  Spread Helper — GÖRÜNÜR CEP paneli (Premiere Pro): Window > Extensions (Legacy) > Spread Helper.
  Panel açıkken 127.0.0.1:47731'de Spread (UXP) panelinin köprüsünü dinler ve kendi BAĞLA düğmesiyle KES planını bağlar
  (ExtendScript Sequence.linkSelection). Premiere, açık bırakılan paneli çalışma alanıyla (workspace) birlikte hatırlar.

  v0.3.2 kararı: v0.3.0'daki GÖRÜNMEZ (Type=Custom, AutoVisible=false, <StartOn> olaylarıyla kendiliğinden başlayan) yardımcı
  gerçek Windows / Premiere 26.5.1 kurulumunda HİÇ başlamadı (127.0.0.1:47731 açılmadı). Gizli başlatmanın Premiere'deki
  güvenilirliğiyle ilgili kaynaklar handoff.md'de. Görünür panel: kullanıcı açar, durumunu görür, sunucu panel açıkken çalışır.

  Kaynaklar (Adobe, birincil):
   - CEP 12 HTML Extension Cookbook: manifest, UI Type Panel, Menu, Geometry, CEF bayrakları (enable-nodejs, mixed-context),
     ScriptPath, uzaktan hata ayıklama (.debug):
     https://github.com/Adobe-CEP/CEP-Resources/blob/master/CEP_12.x/Documentation/CEP%2012%20HTML%20Extension%20Cookbook.md
   - RangedVersion (XSD): "[25.0,99.9]" = 25.0 ve üstü
-->
<ExtensionManifest Version="12.0" ExtensionBundleId="com.badideagency.spread.helper" ExtensionBundleVersion="0.3.2"
    ExtensionBundleName="Spread Helper" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.badideagency.spread.helper.panel" Version="0.3.2" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[25.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.badideagency.spread.helper.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Spread Helper</Menu>
          <Geometry>
            <Size>
              <Height>460</Height>
              <Width>340</Width>
            </Size>
            <MinSize>
              <Height>220</Height>
              <Width>240</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
